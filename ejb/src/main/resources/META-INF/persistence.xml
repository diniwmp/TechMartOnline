<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="techmart-pu" transaction-type="JTA">

        <!-- This JNDI name must match the datasource you configure on
             your application server (WildFly/Payara). See the deployment
             guide for the exact CLI/admin-console commands. -->
        <jta-data-source>jdbc/techMartOnline</jta-data-source>

        <class>lk.tmart.core.model.User</class>
        <class>lk.tmart.core.model.UserRole</class>
        <class>lk.tmart.core.model.UserProfile</class>

        <properties>
            <!-- Set to 'update' during development so Hibernate creates/updates
                 tables from your entities. Switch to 'validate' once your
                 schema is stable, for the production/deployment NFR story. -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

            <!-- Connection pool tuning  mention these numbers explicitly
                 in your "Database integration with connection optimization"
                 deliverable section. -->
            <property name="hibernate.connection.pool_size" value="20"/>
            <property name="hibernate.generate_statistics" value="true"/>
        </properties>

    </persistence-unit>
</persistence>
